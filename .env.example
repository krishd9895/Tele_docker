# ─────────────────────────────────────────────────────────────────────────────
# Telegram Bot Manager — Environment Configuration Template
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your actual values.
# Sensitive keys (tokens, passwords) STAY IN .env ONLY — never in MongoDB.
#
# ─────────────────────────────────────────────────────────────────────────────

# ══════════════════════════════════════════════════════════════════════════════
# CORE AUTHENTICATION (REQUIRED)
# ══════════════════════════════════════════════════════════════════════════════

# Your Telegram Bot Token
# Get it from @BotFather on Telegram: https://t.me/BotFather
TELEGRAM_BOT_TOKEN=123456789:ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefgh

# Your Telegram User ID (who can use this bot)
# Get it from @userinfobot on Telegram: https://t.me/userinfobot
ALLOWED_USER_ID=123456789


# ══════════════════════════════════════════════════════════════════════════════
# DATABASE & PERSISTENCE (OPTIONAL)
# ══════════════════════════════════════════════════════════════════════════════

# MongoDB URI for storing runtime settings
# If empty or contains "optional", bot runs natively off .env variables only
# Format: mongodb://user:password@host:port/database
# Example (local): mongodb://localhost:27017/tg_docker_manager
# Example (cloud): mongodb+srv://user:password@cluster.mongodb.net/tg_docker_manager
MONGO_URI=

# Local SQLite database path (for non-MongoDB operations)
# Default: data/manager.db
DB_PATH=data/manager.db


# ══════════════════════════════════════════════════════════════════════════════
# HOST SSH ACCESS (REQUIRED for /host, /download, /upload, /gitpull, /compose)
# ══════════════════════════════════════════════════════════════════════════════

# WSL Ubuntu username
# This is the username of the account on your WSL machine that owns your working directories
# Example: ubuntu, user, admin, etc.
HOST_SSH_USER=ubuntu

# WSL Ubuntu password
# Password for the above SSH user (for SSH authentication)
# Note: SSH key-based auth not yet supported; password required
HOST_SSH_PASSWORD=your_wsl_password_here

# SSH host address
# Default: 127.0.0.1 (localhost/WSL loopback)
HOST_SSH_HOST=127.0.0.1

# SSH port
# Default: 22
# Make sure WSL SSH service is running: sudo service ssh start
HOST_SSH_PORT=22


# ══════════════════════════════════════════════════════════════════════════════
# FILE BROWSER SETTINGS (OPTIONAL)
# ══════════════════════════════════════════════════════════════════════════════

# Root directory for /download and /upload file browser
# This is the starting directory when users browse files
# Only subdirectories below this path will be accessible
# Example: /home/ubuntu, /home/user, /workspace, /projects
BROWSER_ROOT=/home/ubuntu


# ══════════════════════════════════════════════════════════════════════════════
# GIT OPERATIONS (OPTIONAL)
# ══════════════════════════════════════════════════════════════════════════════

# Comma-separated paths on WSL host for /gitpull to scan
# The bot will discover all git repositories under these paths
# Examples:
#   /home/ubuntu
#   /home/ubuntu,/home/ubuntu/bots
#   /home/ubuntu,/home/ubuntu/projects,/opt/workspaces
GIT_SCAN_PATHS=/home/ubuntu


# ══════════════════════════════════════════════════════════════════════════════
# PYTHON APP DEPLOYMENTS (OPTIONAL — used by /pydeploy, /pyps)
# ══════════════════════════════════════════════════════════════════════════════

# Root folder on the WSL host where deployed Python projects are stored.
# Relative paths are resolved under the SSH user's home directory;
# an absolute path (starting with "/") is used as-is.
# Default: py_deployments  (i.e. ~/py_deployments)
PY_DEPLOY_ROOT=py_deployments


# ══════════════════════════════════════════════════════════════════════════════
# DOCKER OPERATIONS (OPTIONAL)
# ══════════════════════════════════════════════════════════════════════════════

# Timeout (in seconds) for docker deploy operations
# Default: 600 (10 minutes)
DEPLOYMENT_TIMEOUT=600


# ══════════════════════════════════════════════════════════════════════════════
# 2FA / SECURITY (OPTIONAL but Highly Recommended)
# ══════════════════════════════════════════════════════════════════════════════

# Admin password for /verify command (2FA bypass)
# If not set, /verify will use TOTP instead
# Example: MySecureAdminPass123
SECRET_ADMIN_PASSWORD=

# TOTP 2FA secret (for /verify command — one-time codes)
# Generate with: python3 -c "import pyotp; print(pyotp.random_base32())"
# Then scan the resulting QR code with Google Authenticator or Authy
TOTP_SECRET=

# How long a user stays verified after /verify
# Format: seconds (default: 4 hours = 14400)
TOTP_SESSION_DURATION=14400


# ══════════════════════════════════════════════════════════════════════════════
# DUCKDNS DYNAMIC DNS (OPTIONAL)
# ══════════════════════════════════════════════════════════════════════════════

# DuckDNS token (from https://www.duckdns.org/)
# Get it by logging in and copying your token
DUCKDNS_TOKEN=

# Your DuckDNS domain name (without .duckdns.org)
# Example: mydomain (resolves to mydomain.duckdns.org)
DUCKDNS_DOMAIN=

# How often (in seconds) to update DuckDNS with your current IP
# Default: 300 (5 minutes)
DUCKDNS_UPDATE_INTERVAL=300


# ══════════════════════════════════════════════════════════════════════════════
# CLOUDFLARE TUNNELS (OPTIONAL)
# ══════════════════════════════════════════════════════════════════════════════

# Cloudflare named tunnel token (for permanent, fixed-URL tunnels)
# Create a tunnel at https://dash.cloudflare.com/
# This is different from temporary /expose tunnels (which need no setup)
CF_TUNNEL_TOKEN=
